{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dagster Designer",
  "version": "0.1.0",
  "identifier": "com.dagsterlabs.designer",
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "npm run build --prefix frontend",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dagster Designer",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2N0U4NkIzQkM4QzhFRDYKUldUV2pveThzNForeGovWE41SUpjWGVCVWhuK2o2KzZjOFkwMzdDQS9hWXA5WGFMeDY5Tm84R2oK",
      "endpoints": [
        "https://github.com/eric-thomas-dagster/dagster-designer-desktop/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "dagster-designer"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend/app": "backend/app",
      "../backend/dagster_designer_components": "backend/dagster_designer_components",
      "../backend/templates": "backend/templates",
      "../backend/scripts": "backend/scripts",
      "../backend/pyproject.toml": "backend/pyproject.toml",
      "../backend/uv.lock": "backend/uv.lock",
      "../backend/requirements.txt": "backend/requirements.txt",
      "vendor/uv/uv": "bin/uv",
      "vendor/uv/uvx": "bin/uvx"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
